# ==============================================================================
# Evolve Academy — Environment Configuration Template
# Copy to `.env.local` for local development. Never commit `.env.local` to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Backend & Database)
# ------------------------------------------------------------------------------
# Public Supabase URL (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (safe in browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only service role key (NEVER expose to browser; bypasses RLS for webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Chargily Pay V2 Gateway (Algeria: EDAHABIA / CIB)
# ------------------------------------------------------------------------------
# Operating mode: 'test' for Sandbox, 'live' for Real Production
CHARGILY_MODE=test

# Chargily Secret Key (server-side only; starts with test_sk_ or live_sk_)
CHARGILY_SECRET_KEY=test_sk_your_chargily_secret_key

# Optional Chargily Public / API Key
CHARGILY_API_KEY=test_pk_your_chargily_public_key

# Optional API URL override (defaults to test or live pay.chargily.net URL based on CHARGILY_MODE)
# CHARGILY_API_URL=https://pay.chargily.net/test/api/v2

# ------------------------------------------------------------------------------
# 3. Application & Deployment URLs
# ------------------------------------------------------------------------------
# Base public URL of the application
NEXT_PUBLIC_SITE_URL=https://evolve-academy.dz

# Local or tunnel URL for webhook delivery during development (e.g. ngrok)
APP_URL=http://localhost:3000
